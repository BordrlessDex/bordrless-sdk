{
  "name": "@bordrless/sdk",
  "version": "0.14.0",
  "type": "module",
  "description": "TypeScript client of the Bordrless programs: addresses, account and event decoding from the IDLs, instruction builders for every program (the token standard, the DEX, the bridge, the launchpad, the kit, companions, scripts and approvals), the resolution of a hook's extra accounts, balance changes for integrators, and the bordrless CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BordrlessDex/bordrless-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/BordrlessDex/bordrless-sdk#readme",
  "keywords": [
    "solana",
    "bordrless",
    "hooks",
    "dex",
    "launchpad",
    "anchor"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "idl"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "bordrless": "./dist/cli/bordrless.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.1",
    "@bordrless/shared": "workspace:^",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "24.13.3",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "bin": {
    "bordrless": "./src/cli/bordrless.ts"
  }
}
